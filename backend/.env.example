# Copia aquest fitxer com a .env i afegeix les teves claus

# OpenRouteService — routing i geocodificació (gratuït)
# Registre: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=la_teva_clau_aqui

# Open Charge Map — carregadors DC reals (gratuït)
# Registre: https://openchargemap.org/site/develop/api
OCM_API_KEY=la_teva_clau_aqui

# Google Places — restaurants prop del carregador
# Consola: https://console.cloud.google.com → API Places
GOOGLE_PLACES_KEY=la_teva_clau_aqui
